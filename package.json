{
  "name": "suraj-lights-ranthambore",
  "version": "1.0.0",
  "description": "Suraj Light's Ranthambore - Grand Event Lighting, Tenting & Royal Decor MERN Stack Application",
  "main": "backend/server.js",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "deploy": "npx wrangler deploy",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "mern",
    "event-lighting",
    "wedding-decor",
    "ranthambore",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Suraj Light's Ranthambore",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wrangler": "^3.109.2"
  }
}
