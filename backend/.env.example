PORT=5000
MONGO_URI=mongodb://localhost:27017/elan_weddings
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ----------------------------------------------------------------------
# OPTION 1: EASIEST & INSTANT (No Google Password Needed!)
# ----------------------------------------------------------------------
# 1. Open: https://web3forms.com
# 2. Enter your email address and click "Create Access Key".
# 3. Paste the Access Key below:
# ----------------------------------------------------------------------
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ----------------------------------------------------------------------
# OPTION 2: STANDARD SMTP / NODEMAILER
# ----------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_TO=your-email@gmail.com
EMAIL_FROM_NAME="Élan Weddings Concierge"
